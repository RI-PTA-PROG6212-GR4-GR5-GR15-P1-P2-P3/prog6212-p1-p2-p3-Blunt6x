@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap">
    <div class="auth-card">
        <partial name="_Alerts" />
        <div class="rd-card">
            <h1 class="h2 mb-1">Welcome back</h1>
            <p class="text-muted">Log in to enrol, track your races and manage events.</p>
            <form asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-lg" data-busy="Logging in…">Log in</button>
            </form>
            <p class="text-center text-muted mt-4 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
