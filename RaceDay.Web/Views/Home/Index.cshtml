@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
    ViewData["FullBleed"] = true;
    var user = Context.Session.GetUser();
}
<section class="hero">
    <div class="container">
        <h1>Find your next <span class="volt">start line</span></h1>
        <p class="lead">Runs, walks and rides near you. Pick an event, choose your category and lock in your place in seconds.</p>
        <div class="hero-stats">
            <div><div class="num">@Model.TotalUpcoming</div><div class="lbl">Upcoming events</div></div>
            @if (user is null)
            {
                <div class="align-self-center"><a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Join RaceDay</a> <a class="btn btn-outline-light btn-lg ms-1" asp-controller="Account" asp-action="Login">Log in</a></div>
            }
        </div>
    </div>
</section>

<div class="container">
    <form method="get" asp-controller="Home" asp-action="Index" class="filter-bar">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label" for="search">Search</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="type">Type</label>
                <select id="type" name="type" class="form-select">
                    <option value="">All types</option>
                    @foreach (var t in new[] { "Run", "Walk", "Cycle" })
                    {
                        <option value="@t" selected="@(string.Equals(Model.Type, t, StringComparison.OrdinalIgnoreCase))">@t</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="minDistance">Min km</label>
                <input id="minDistance" name="minDistance" type="number" step="0.1" min="0" value="@Model.MinDistance" class="form-control" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="maxDistance">Max km</label>
                <input id="maxDistance" name="maxDistance" type="number" step="0.1" min="0" value="@Model.MaxDistance" class="form-control" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="sort">Sort by</label>
                <select id="sort" name="sort" class="form-select">
                    <option value="date" selected="@(Model.Sort == "date")">Date</option>
                    <option value="distance" selected="@(Model.Sort == "distance")">Distance</option>
                    <option value="name" selected="@(Model.Sort == "name")">Name</option>
                </select>
            </div>
            <div class="col-6 col-lg-3">
                <label class="form-label" for="dateFrom">From date</label>
                <input id="dateFrom" name="dateFrom" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-6 col-lg-3">
                <label class="form-label" for="dateTo">To date</label>
                <input id="dateTo" name="dateTo" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-12 col-lg-3">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="includePast" name="includePast" value="true" checked="@Model.IncludePast" />
                    <label class="form-check-label" for="includePast">Include past events</label>
                </div>
            </div>
            <div class="col-12 col-lg-3 d-flex gap-2 justify-content-lg-end">
                <button type="submit" class="btn btn-primary flex-grow-1 flex-lg-grow-0">Apply filters</button>
                @if (Model.HasFilters || Model.Sort != "date")
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </div>
        </div>
    </form>

    <div class="pt-4"><partial name="_Alerts" /></div>

    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert alert-danger rd-alert" role="alert">@loadError</div>
    }
    else if (!Model.Events.Any())
    {
        <div class="rd-card empty-state mt-3">
            <div class="icon">🏁</div>
            <h2 class="h4 mt-2">No events match</h2>
            <p class="mb-3">@(Model.HasFilters ? "Try widening your filters to see more events." : "There are no upcoming events yet. Check back soon!")</p>
            @if (Model.HasFilters) { <a class="btn btn-outline-primary" asp-action="Index">Clear filters</a> }
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-baseline mb-3 mt-2">
            <h2 class="h3 mb-0">@(Model.IncludePast ? "Events" : "Upcoming events") <small class="text-muted fs-6 text-capitalize">@Model.Events.Count shown</small></h2>
        </div>
        <div class="row g-4">
            @foreach (var ev in Model.Events)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <partial name="_EventCard" model="ev" view-data="@(new ViewDataDictionary(ViewData) { { "Enrolled", Model.EnrolledEventIds.Contains(ev.EventId) } })" />
                </div>
            }
        </div>
    }
</div>
