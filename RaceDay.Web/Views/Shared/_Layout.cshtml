@{
    var user = Context.Session.GetUser();
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");
    string Active(string c, string? a = null) => controller.Equals(c, StringComparison.OrdinalIgnoreCase) && (a is null || action.Equals(a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " · " : "")RaceDay</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index"><img src="~/images/logo.svg" alt="" width="34" height="34" /><span>RACE<em>DAY</em></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (user is null)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Events</a></li>
                    }
                    else if (user.IsOrganiser)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageEvents")" asp-controller="ManageEvents" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageCategories")" asp-controller="ManageCategories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageEnrolments")" asp-controller="ManageEnrolments" asp-action="Index">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageResults")" asp-controller="ManageResults" asp-action="Index">Results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @(Active("Home") + Active("Events"))" asp-controller="Home" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyEnrolments")" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (user is null)
                    {
                        <li class="nav-item"><a class="nav-link @(Active("Account", "Login"))" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <partial name="_Avatar" model="user" />
                                <span class="d-none d-lg-inline">@user.FirstName</span>
                                <span class="role-pill">@user.Role</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">@user.FullName<br /><small class="text-muted">@user.Email</small></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item">Log out</button></form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="rd-main" role="main">
    @if (ViewData["FullBleed"] is not true)
    {
        <div class="container pt-4"><partial name="_Alerts" /></div>
    }
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <span class="rd-brand-sm">RACE<em>DAY</em></span>
        <span>Run it. Walk it. Ride it. · &copy; @DateTime.Now.Year RaceDay</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
