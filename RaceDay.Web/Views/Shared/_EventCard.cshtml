@model EventDto
@{ var enrolled = ViewData["Enrolled"] is true; }
<article class="event-card h-100">
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="event-card-media" tabindex="-1" aria-hidden="true">
        <partial name="_Banner" model="Model" />
        <span class="type-chip">@UiFormat.EventTypeIcon(Model.EventType) @Model.EventType</span>
        @if (!Model.IsUpcoming) { <span class="past-chip">Completed</span> }
    </a>
    <div class="event-card-body">
        <div class="event-date">@UiFormat.LongDate(Model.Date) · @Model.Date.ToString("HH:mm")</div>
        <h3 class="event-title"><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.Name</a></h3>
        <ul class="event-meta list-unstyled">
            <li><span class="meta-label">Where</span> @Model.Location</li>
            <li><span class="meta-label">Distance</span> @UiFormat.Distance(Model.Distance)</li>
        </ul>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            @if (enrolled) { <span class="status-badge status-confirmed"><span class="dot"></span>You're in</span> } else { <span></span> }
            <a class="btn btn-outline-primary btn-sm" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
        </div>
    </div>
</article>
