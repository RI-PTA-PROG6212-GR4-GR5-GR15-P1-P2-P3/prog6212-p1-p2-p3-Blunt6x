@model EventFormViewModel
@{ ViewData["Title"] = Model.IsEdit ? "Edit event" : "New event"; }
<div class="container pb-4" style="max-width: 880px;">
    <div class="page-header">
        <div><h1>@(Model.IsEdit ? "Edit event" : "Create event")</h1><p class="sub">@(Model.IsEdit ? "Update the details participants see." : "Tell participants what, where and when.")</p></div>
    </div>
    <div class="rd-card card-pad">
        <form method="post" enctype="multipart/form-data" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ExistingBannerUrl" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label">Event name</label>
                    <input asp-for="Name" class="form-control" maxlength="120" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="1000"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Date" class="form-label">Date &amp; start time</label>
                    <input asp-for="Date" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" maxlength="180" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Distance" class="form-label">Distance (km)</label>
                    <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="Distance" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Banner" class="form-label">Event banner</label>
                    <div class="d-flex flex-wrap gap-3 align-items-start">
                        <div>
                            <img id="bannerPreview" class="banner-preview @(string.IsNullOrWhiteSpace(Model.ExistingBannerUrl) ? "d-none" : "")" src="@Model.ExistingBannerUrl" alt="Current event banner" />
                        </div>
                        <div class="flex-grow-1" style="min-width: 240px;">
                            <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="#bannerPreview" />
                            <div class="form-text">JPG, PNG, GIF or WebP · up to 5 MB · wide images (e.g. 1600×600) look best. @(Model.IsEdit ? "Leave empty to keep the current banner." : "")</div>
                            <span asp-validation-for="Banner" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg px-4" data-busy="Saving…">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
