@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    var user = Context.Session.GetUser()!;
    var enrolled = Model.MyEnrolment is not null;
}
<div class="container pb-4">
    <nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Events</a></li><li class="breadcrumb-item active" aria-current="page">@ev.Name</li></ol></nav>

    <div class="event-hero-banner mb-4"><partial name="_Banner" model="ev" /></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <span class="status-badge status-other">@UiFormat.EventTypeIcon(ev.EventType) @ev.EventType</span>
                @if (ev.IsUpcoming) { <span class="status-badge status-upcoming">@UiFormat.Countdown(ev.Date)</span> } else { <span class="status-badge status-completed">Completed</span> }
            </div>
            <h1 class="display-5 mb-3">@ev.Name</h1>
            <div class="detail-facts mb-4">
                <div class="fact"><div class="k">Date</div><div class="v">@UiFormat.LongDate(ev.Date)</div></div>
                <div class="fact"><div class="k">Start time</div><div class="v">@ev.Date.ToString("HH:mm")</div></div>
                <div class="fact"><div class="k">Location</div><div class="v">@ev.Location</div></div>
                <div class="fact"><div class="k">Distance</div><div class="v">@UiFormat.Distance(ev.Distance)</div></div>
            </div>
            <div class="rd-card card-pad mb-4">
                <h2 class="h4">About this event</h2>
                <p class="mb-0" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(ev.Description) ? "The organiser hasn't added a description yet." : ev.Description)</p>
            </div>

            <div class="rd-card">
                <div class="card-title-row"><h2>Categories</h2><span class="text-muted small">@Model.Categories.Count available</span></div>
                @if (ViewData["CategoryError"] is string ce)
                {
                    <div class="card-pad"><div class="alert alert-warning mb-0">@ce</div></div>
                }
                else if (!Model.Categories.Any())
                {
                    <div class="empty-state"><div class="icon">🗂️</div><p class="mb-0">No categories have been added yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table rd-table">
                            <thead><tr><th>Category</th><th>Age group</th><th>Details</th></tr></thead>
                            <tbody>
                                @foreach (var c in Model.Categories)
                                {
                                    <tr><td class="fw-semibold">@c.Name</td><td>@UiFormat.AgeRange(c.MinimumAge, c.MaximumAge)</td><td class="text-muted">@(string.IsNullOrWhiteSpace(c.Description) ? "—" : c.Description)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="rd-card card-pad position-sticky" style="top: 1rem;">
                @if (user.IsOrganiser)
                {
                    <h2 class="h4">Organiser view</h2>
                    <p class="text-muted">Organisers manage events from the dashboard.</p>
                    @if (ev.OrganiserId == user.UserId)
                    {
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@ev.EventId">Edit event</a>
                            <a class="btn btn-outline-primary" asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">View enrolments</a>
                        </div>
                    }
                }
                else if (enrolled)
                {
                    <h2 class="h4">You're enrolled</h2>
                    <p class="mb-2">Category: <strong>@Model.MyEnrolment!.Category.Name</strong></p>
                    <p class="mb-3"><partial name="_StatusBadge" model="Model.MyEnrolment.Status" /></p>
                    <a class="btn btn-outline-primary w-100" asp-controller="Participant" asp-action="MyEnrolments">View my enrolments</a>
                }
                else if (!ev.IsUpcoming)
                {
                    <h2 class="h4">Enrolment closed</h2>
                    <p class="text-muted mb-0">This event has already taken place.</p>
                }
                else if (!Model.Categories.Any())
                {
                    <h2 class="h4">Enrol</h2>
                    <p class="text-muted mb-0">Enrolment opens once the organiser adds categories.</p>
                }
                else
                {
                    <h2 class="h4">Enrol now</h2>
                    <p class="text-muted">Choose your category to secure your place.</p>
                    <form asp-controller="Events" asp-action="Enrol" method="post">
                        <input type="hidden" name="eventId" value="@ev.EventId" />
                        <div class="d-grid gap-2 mb-3">
                            @foreach (var c in Model.Categories)
                            {
                                <div>
                                    <input class="category-option-input" type="radio" name="categoryId" id="cat-@c.CategoryId" value="@c.CategoryId" required />
                                    <label class="category-option" for="cat-@c.CategoryId"><strong>@c.Name</strong><br /><small class="text-muted">@UiFormat.AgeRange(c.MinimumAge, c.MaximumAge)</small></label>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100" data-busy="Enrolling…">Enrol for this event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
